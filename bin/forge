#!/usr/bin/env bash
# forge — a thin, forge-agnostic adapter over `gh` (GitHub) and `glab` (GitLab).
#
# The orchestrator (loop.ts etc.) AND the agent prompts call `forge <verb>`,
# never `gh`/`glab` directly. Swap platforms by setting FORGE_PLATFORM.
# Identity is whatever token is in the environment when forge is called
# (e.g. `GH_TOKEN="$REVIEW_TOKEN" forge pr-approve 5` posts as the reviewer).
#
#   FORGE_PLATFORM = github | gitlab   (required)
#
# Normalized review state (pr-list / pr-review-state): APPROVED | CHANGES_REQUESTED | REVIEW_REQUIRED
#
# Requires: jq, and gh (github) or glab (gitlab).
set -euo pipefail

PLATFORM="${FORGE_PLATFORM:-github}"
verb="${1:-}"; shift || true

die() { echo "forge: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
need jq

case "$PLATFORM" in
  github) need gh ;;
  gitlab) need glab ;;
  *) die "unknown FORGE_PLATFORM '$PLATFORM' (expected github|gitlab)" ;;
esac

# ---- arg helpers -----------------------------------------------------------
# Collect repeated --label values and pass-through of common flags.
labels=(); title=""; body=""; body_file=""; base=""; comment=""; state="open"
add_labels=(); rm_labels=(); new_title=""; POS=(); SQUASH=0; DELBR=0; REVIEWER=0; NOAUTO=0
git_name=""; git_email=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --label) labels+=("$2"); shift 2 ;;
    --add-label) add_labels+=("$2"); shift 2 ;;
    --remove-label) rm_labels+=("$2"); shift 2 ;;
    --title) title="$2"; shift 2 ;;
    --new-title) new_title="$2"; shift 2 ;;
    --body) body="$2"; shift 2 ;;
    --body-file) body_file="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --comment) comment="$2"; shift 2 ;;
    --state) state="$2"; shift 2 ;;
    --squash) SQUASH=1; shift ;;
    --delete-branch) DELBR=1; shift ;;
    --as-reviewer) REVIEWER=1; shift ;;
    --no-auto-merge) NOAUTO=1; shift ;;
    --git-name) git_name="$2"; shift 2 ;;
    --git-email) git_email="$2"; shift 2 ;;
    *) POS+=("$1"); shift ;;
  esac
done

# --as-reviewer: run this call under the reviewer identity (FORGE_REVIEW_TOKEN),
# so an approval is not attributed to the PR/MR author.
if [[ "${REVIEWER:-0}" == 1 ]]; then
  : "${FORGE_REVIEW_TOKEN:?--as-reviewer requires FORGE_REVIEW_TOKEN in the environment}"
  if [[ "$PLATFORM" == github ]]; then export GH_TOKEN="$FORGE_REVIEW_TOKEN"
  else export GITLAB_TOKEN="$FORGE_REVIEW_TOKEN"; export GLAB_TOKEN="$FORGE_REVIEW_TOKEN"; fi
fi
NUM="${POS[0]:-}"
CHANGES_LABEL="changes-requested"   # GitLab convention for "request changes"

# Build per-platform label flags
gh_label_flags() { local f=(); for l in "$@"; do f+=(--label "$l"); done; printf '%s\n' "${f[@]}"; }
csv() { local IFS=,; echo "$*"; }

# gitlab: echo "<project_id> <iid> <head_pipeline_id>" for MR number $1 (pipeline id may be empty)
gl_ctx() {
  local mr pid iid pip
  mr="$(glab mr view "$1" -F json)"
  pid="$(jq -r '.project_id' <<<"$mr")"; iid="$(jq -r '.iid' <<<"$mr")"
  pip="$(glab api "projects/$pid/merge_requests/$iid" 2>/dev/null | jq -r '.head_pipeline.id // empty')"
  echo "$pid $iid $pip"
}

# --- transient-error retry --------------------------------------------------
# GitHub/GitLab intermittently return transient infra errors (5xx gateway,
# service-unavailable, timeouts, secondary rate limits). Retry READ verbs with
# exponential backoff so a momentary blip doesn't fail the caller (e.g. burn an
# AFK loop cycle). MUTATING verbs are NOT retried — a retry after a partial write
# could double-apply (duplicate comment/label/merge). Tunable via FORGE_MAX_RETRIES
# and FORGE_RETRY_BASE_SECONDS (base 0 => instant backoff, used by the tests).
FORGE_MAX_RETRIES="${FORGE_MAX_RETRIES:-4}"
FORGE_RETRY_BASE_SECONDS="${FORGE_RETRY_BASE_SECONDS:-2}"
TRANSIENT_RE='HTTP 5[0-9][0-9]|bad gateway|gateway time|service unavailable|internal server error|temporarily unavailable|handshake timeout|i/o timeout|client\.timeout|timed out|timeout|connection reset|connection refused|\beof\b|secondary rate limit|abuse detection|try again'

is_retryable_verb() {
  case "$1" in
    issue-list|issue-view|issue-comments|issue-discussion|whoami|pr-list|pr-view|pr-diff|pr-changes-count|pr-pipeline|pr-pipeline-failed-jobs|pr-pipeline-failures|pr-pipeline-retry-count|pr-has-conflicts|pr-head-exists|pr-conflict-retry-count|pr-heal-count|pr-review-gate|pr-feedback) return 0 ;;
    *) return 1 ;;
  esac
}

# The verb dispatch. run_with_retry runs it in a `( set -e; dispatch )` subshell
# so its fail-fast (set -e + pipefail) semantics are preserved while the caller
# captures the exit code and stderr to decide whether to retry.
dispatch() {
case "$verb" in
  # ---------- issues ----------
  issue-list)
    if [[ "$PLATFORM" == github ]]; then
      args=(issue list --state "$state" --json number,title,labels --limit 200)
      [[ ${#labels[@]} -gt 0 ]] && while read -r f; do args+=("$f"); done < <(gh_label_flags "${labels[@]}")
      gh "${args[@]}" | jq '[.[] | {number, title, labels: [.labels[].name]}]'
    else
      # glab `issue list`: state is --opened/--closed/--all (no --state); JSON is --output (not -F).
      gl=(); case "$state" in closed) gl=(--closed);; all) gl=(--all);; esac
      lbl=(); [[ ${#labels[@]} -gt 0 ]] && lbl=(--label "$(csv "${labels[@]}")")
      glab issue list ${gl[@]+"${gl[@]}"} ${lbl[@]+"${lbl[@]}"} --output json \
        | jq '[.[] | {number: .iid, title, labels: (.labels // [])}]'
    fi ;;

  issue-view)
    [[ -n "$NUM" ]] || die "issue-view needs <number>"
    # `state` (lowercased open/closed) feeds the loop's blocker-sweep isClosed check —
    # it MUST be emitted or the sweep never unblocks anything. gh returns OPEN/CLOSED;
    # glab returns opened/closed. Normalize both to open/closed.
    if [[ "$PLATFORM" == github ]]; then
      gh issue view "$NUM" --json number,title,body,labels,state | jq '{number, title, body, labels: [.labels[].name], state: (.state | ascii_downcase)}'
    else
      glab issue view "$NUM" -F json | jq '{number: .iid, title, body: (.description // ""), labels: (.labels // []), state: (if .state == "closed" then "closed" else "open" end)}'
    fi ;;

  issue-create)
    [[ -n "$title" && -n "$body_file" ]] || die "issue-create needs --title and --body-file"
    if [[ "$PLATFORM" == github ]]; then
      args=(issue create --title "$title" --body-file "$body_file")
      while read -r f; do args+=("$f"); done < <(gh_label_flags "${labels[@]}")
      gh "${args[@]}"
    else
      glab issue create --title "$title" --description "$(cat "$body_file")" \
        $( [[ ${#labels[@]} -gt 0 ]] && echo --label "$(csv "${labels[@]}")" ) --yes
    fi ;;

  issue-edit)
    [[ -n "$NUM" ]] || die "issue-edit needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      args=(issue edit "$NUM"); [[ -n "$body_file" ]] && args+=(--body-file "$body_file")
      [[ -n "$new_title" ]] && args+=(--title "$new_title")
      for l in "${add_labels[@]:-}"; do [[ -n "$l" ]] && args+=(--add-label "$l"); done
      for l in "${rm_labels[@]:-}"; do [[ -n "$l" ]] && args+=(--remove-label "$l"); done
      gh "${args[@]}"
    else
      args=(issue update "$NUM"); [[ -n "$body_file" ]] && args+=(--description "$(cat "$body_file")")
      [[ -n "$new_title" ]] && args+=(--title "$new_title")
      [[ ${#add_labels[@]:-0} -gt 0 ]] && args+=(--label "$(csv "${add_labels[@]}")")
      [[ ${#rm_labels[@]:-0} -gt 0 ]] && args+=(--unlabel "$(csv "${rm_labels[@]}")")
      glab "${args[@]}"
    fi ;;

  issue-close)
    [[ -n "$NUM" ]] || die "issue-close needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh issue close "$NUM" $( [[ -n "$comment" ]] && echo --comment "$comment" )
    else
      [[ -n "$comment" ]] && glab issue note "$NUM" -m "$comment" || true
      glab issue close "$NUM"
    fi ;;

  issue-comment)  # post a comment on an issue (used by the triage sweep's audit marker)
    [[ -n "$NUM" ]] || die "issue-comment needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh issue comment "$NUM" --body "$body"; else glab issue note "$NUM" -m "$body"; fi ;;

  issue-comments)  # emit an issue's comment bodies (the triage sweep greps these for its marker)
    [[ -n "$NUM" ]] || die "issue-comments needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh issue view "$NUM" --json comments | jq -r '.comments[]?.body // empty'
    else
      glab issue note list "$NUM" -F json 2>/dev/null | jq -r '.[].notes[]?.body // empty' 2>/dev/null || true
    fi ;;

  issue-discussion)  # an issue's MAINTAINER discussion as readable markdown, oldest first — for agent prompts
    # Comments often refine or amend the body; issue-view carries only the body. But the body is vetted
    # by whoever applied the ready label, and comments can come from ANYONE (on a public repo, any
    # account): agents holding push/approve credentials must not take their spec from an outsider. So
    # only trusted authors' comments are shown, and the omitted ones are COUNTED, never hidden silently:
    #   GitHub: the author's ACTUAL permission on this repo (collaborators/<login>/permission) must be in
    #           $FORGE_TRUSTED_PERMISSIONS (default admin,maintain,write) — authorAssociation is too loose
    #           (MEMBER is any org member, COLLABORATOR includes read-only) (#84). Minimized comments dropped.
    #           Trusted if EITHER role_name (e.g. maintain) or the base permission (a custom role that
    #           inherits write reports permission "write") is listed. At most 15 lookups (newest authors
    #           first) to stay well inside sandcastle's 30s prompt timeout; the rest are untrusted.
    #   GitLab: the note author's project access level >= $FORGE_TRUSTED_ACCESS_LEVEL (default 30,
    #           Developer); notes are read newest-first (100) via the REST API; system notes dropped.
    #   Both: logins in $FORGE_UNTRUSTED_AUTHORS (comma list, case-insensitive — set it to the loop's own bot accounts) are
    #   never trusted, so an agent can't post an issue comment the independent reviewer reads as spec.
    # The loop's own markers and `AFK:` notices are dropped; at most the newest 20 comments of <= 3000
    # chars each are shown.
    # Fails (and retries) like any read verb; prompts add a visible fallback.
    [[ -n "$NUM" ]] || die "issue-discussion needs <number>"
    disc_defs='
      def is_marker: test("^\\s*(\\[(afk-triage\\]|afk:resume\\]|afk:rebuttal\\]|afk:no-pr|forge:)|AFK:)");
      def clip: if length > 3000 then .[0:3000] + "\n\n…(comment truncated)" else . end;
      def render:
        map(select((.body | length) > 0 and (.body | is_marker | not))) | sort_by(.at) as $all
        | ($all | map(select(.ok))) as $t
        | ($all | map(select(.ok | not)) | length) as $omitted
        | ($t | length) as $n
        | (if $n == 0 then "(no comments)"
           else ((if $n > 20 then "(Showing the newest 20 of \($n) maintainer comments.)\n\n" else "" end)
                 + ($t[-20:] | map("### Comment by @\(.who) on \(.at[0:10])\n\n" + (.body | clip)) | join("\n\n---\n\n")))
           end)
        + (if $omitted > 0 then "\n\n(\($omitted) comment(s) from non-maintainers omitted — they are not part of the spec.)" else "" end);'
    if [[ "$PLATFORM" == github ]]; then
      trusted="${FORGE_TRUSTED_PERMISSIONS:-admin,maintain,write}"
      comments="$(gh issue view "$NUM" --json comments)"
      # Each distinct author's permission on THIS repo (newest first, at most 15). A 404 (no such user /
      # not visible) = untrusted; any other error is an error (fail closed). role_name carries
      # "maintain" or a custom role; permission is the base admin|write|read|none. Both are kept.
      perms='{}'; errf="$(mktemp)"
      for login in $(jq -r '[.comments[]? | .author.login // empty] | reverse | reduce .[] as $l ([]; if index($l) then . else . + [$l] end) | .[0:15] | .[]' <<<"$comments"); do
        if p="$(gh api "repos/{owner}/{repo}/collaborators/$login/permission" 2>"$errf")"; then
          roles="$(jq -c '[.role_name, .permission] | map(select(. != null) | ascii_downcase)' <<<"$p")"
        elif grep -qF "(HTTP 404)" "$errf"; then roles='[]'
        else cat "$errf" >&2; rm -f "$errf"; exit 1; fi
        perms="$(jq -c --arg l "$login" --argjson r "$roles" '. + {($l): $r}' <<<"$perms")"
      done
      rm -f "$errf"
      jq -r --arg trusted "$trusted" --argjson perms "$perms" --arg denied "${FORGE_UNTRUSTED_AUTHORS:-}" "$disc_defs"'
        ($trusted | ascii_downcase | split(",") | map(select(length > 0))) as $tr
        | ($denied | ascii_downcase | split(",") | map(select(length > 0))) as $deny
        | [.comments[]? | {who: (.author.login // "unknown"), at: (.createdAt // ""), body: (.body // ""),
                           ok: (($perms[.author.login // ""] // []) as $r | any($r[]; . as $x | $tr | index($x) != null)
                                and ((.isMinimized // false) | not)
                                and ((.author.login // "" | ascii_downcase) as $l | $deny | index($l)) == null)}]
        | render' <<<"$comments"
    else
      min_level="${FORGE_TRUSTED_ACCESS_LEVEL:-30}"
      issue="$(glab issue view "$NUM" -F json)"
      pid="$(jq -r '.project_id' <<<"$issue")"; iid="$(jq -r '.iid' <<<"$issue")"
      notes="$(glab api "projects/$pid/issues/$iid/notes?sort=desc&order_by=created_at&per_page=100")"
      # Each human author's access level; 404 = not a member (level 0); any other error is an error.
      # At most 15 lookups (newest authors first) so a crowded thread stays inside sandcastle's 30s
      # prompt-command timeout; authors beyond that are treated as untrusted (level 0).
      levels='{}'; errf="$(mktemp)"
      for uid in $(jq -r '[.[] | select((.system // false) | not) | .author.id] | reduce .[] as $i ([]; if index($i) then . else . + [$i] end) | .[0:15] | .[]' <<<"$notes"); do
        if member="$(glab api "projects/$pid/members/all/$uid" 2>"$errf")"; then lvl="$(jq -r '.access_level // 0' <<<"$member")"
        elif grep -q "404" "$errf"; then lvl=0
        else cat "$errf" >&2; rm -f "$errf"; exit 1; fi
        levels="$(jq -c --arg u "$uid" --argjson l "$lvl" '. + {($u): $l}' <<<"$levels")"
      done
      rm -f "$errf"
      jq -r --argjson levels "$levels" --argjson min "$min_level" --arg denied "${FORGE_UNTRUSTED_AUTHORS:-}" "$disc_defs"'
        ($denied | ascii_downcase | split(",") | map(select(length > 0))) as $deny
        | [.[] | select((.system // false) | not)
             | {who: (.author.username // "unknown"), at: (.created_at // ""), body: (.body // ""),
                ok: (($levels[(.author.id | tostring)] // 0) >= $min and ((.author.username // "" | ascii_downcase) as $l | $deny | index($l)) == null)}]
        | render' <<<"$notes"
    fi ;;

  whoami)  # the login of the account this forge token acts as (the loop's own bot, on the host) (#86)
    if [[ "$PLATFORM" == github ]]; then gh api user -q .login
    else glab api user | jq -r '.username'
    fi ;;

  # ---------- pull / merge requests ----------
  pr-create)
    [[ -n "$base" && -n "$title" ]] || die "pr-create needs --base and --title"
    # The branch must already be on origin, AT the local HEAD (#59). GitLab accepts an MR for a
    # source branch that doesn't exist — no commit, no pipeline, can never merge — and the
    # prompt's "push first" is advisory. Fail closed: an ls-remote error is a refusal too.
    cur="$(git branch --show-current 2>/dev/null || true)"
    [[ -n "$cur" ]] || die "pr-create: not on a branch (detached HEAD)"
    local_sha="$(git rev-parse HEAD)" || die "pr-create: cannot resolve HEAD"
    remote_line="$(git ls-remote --heads origin "refs/heads/$cur")" \
      || die "pr-create: could not reach origin to verify '$cur' was pushed (git ls-remote failed)"
    remote_sha="$(cut -f1 <<<"$remote_line")"
    [[ -n "$remote_sha" ]] || die "pr-create: branch '$cur' is not on origin — run: git push -u origin HEAD"
    [[ "$remote_sha" == "$local_sha" ]] \
      || die "pr-create: origin/$cur is at ${remote_sha:0:8} but local HEAD is ${local_sha:0:8} — push first"
    # A PR body is load-bearing: GitHub/GitLab read the closing keyword from it, so a
    # bodyless PR merges without ever closing its issue (zombie issue, re-investigated
    # by the next agent). The prompt asks for it; only forge can enforce it.
    if [[ -n "$body_file" ]]; then
      [[ -f "$body_file" ]] || die "pr-create: --body-file '$body_file' does not exist"
      body="$(cat "$body_file")"
    fi
    [[ -n "${body//[[:space:]]/}" ]] || die "pr-create needs --body or --body-file (non-empty)"
    if ! grep -qiE '(closes|fixes|resolves) #[0-9]+' <<<"$body"; then
      # Self-correct off the loop's branch convention (agent/issue-<N>). Same derivation
      # as review.ts's fallback, so both agree on which issue this PR belongs to.
      [[ "$cur" =~ issue-([0-9]+) ]] \
        || die "pr-create: body has no closing keyword (Closes/Fixes/Resolves #<n>) and branch '$cur' has no issue number to derive one from"
      body="Closes #${BASH_REMATCH[1]}"$'\n\n'"$body"
    fi
    if [[ "$PLATFORM" == github ]]; then
      gh pr create --base "$base" --title "$title" --body "$body"
    else
      glab mr create --source-branch "$cur" --target-branch "$base" \
        --title "$title" --description "$body" --yes --remove-source-branch
    fi ;;

  pr-list)
    if [[ "$PLATFORM" == github ]]; then
      gh pr list --state "$state" --json number,headRefName,reviewDecision,labels,state --limit 100 \
        | jq '[.[] | {number, headRef: .headRefName, merged: (.state == "MERGED"),
              reviewState: (.reviewDecision | if . == "" or . == null then "REVIEW_REQUIRED" else . end),
              labels: [.labels[].name]}]'
    else
      # glab `mr list` state is flag-based and does NOT include approval fields.
      # Query the per-MR /approvals endpoint and FAIL CLOSED: APPROVED only when an
      # approval RULE is satisfied (approvals_required>0 && approvals_left==0) — so a
      # project with no approval rule never auto-merges unreviewed.
      # `closed` must include MERGED MRs, as GitHub's does (#70): GitLab keeps merged in its own
      # state, so `--closed` alone hides them and the loop re-dispatches work that already shipped.
      # --per-page 100 matches gh's --limit 100: glab's default page is 30, so an older merged MR would
      # otherwise drop out of the list on a busy project.
      gl_list() {
        case "$state" in
          closed) { glab mr list --closed --per-page 100 -F json; glab mr list --merged --per-page 100 -F json; } | jq -s 'add | unique_by(.iid)' ;;
          merged) glab mr list --merged --per-page 100 -F json ;;
          all) glab mr list --all --per-page 100 -F json ;;
          *) glab mr list --per-page 100 -F json ;;
        esac
      }
      gl_list | jq -c '.[]' | while read -r mr; do
        iid=$(jq -r '.iid' <<<"$mr"); pid=$(jq -r '.project_id' <<<"$mr")
        appr="$(glab api "projects/$pid/merge_requests/$iid/approvals" 2>/dev/null || echo '{}')"
        jq -n --argjson mr "$mr" --argjson appr "$appr" --arg cr "$CHANGES_LABEL" '
          ($mr.labels // []) as $l |
          {number: $mr.iid, headRef: $mr.source_branch, merged: ($mr.state == "merged"), labels: $l,
           reviewState: (
             if ($l | index($cr)) then "CHANGES_REQUESTED"
             elif (($appr.approvals_required // 0) > 0 and ($appr.approvals_left // 1) == 0) then "APPROVED"
             else "REVIEW_REQUIRED" end)}'
      done | jq -s '.'
    fi ;;

  pr-view)
    [[ -n "$NUM" ]] || die "pr-view needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json number,title,body,headRefName,baseRefName \
        | jq '{number, title, body, headRef: .headRefName, baseRef: .baseRefName}'
    else
      glab mr view "$NUM" -F json \
        | jq '{number: .iid, title, body: (.description // ""), headRef: .source_branch, baseRef: .target_branch}'
    fi ;;

  pr-diff)
    [[ -n "$NUM" ]] || die "pr-diff needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      # GitHub's PR-diff API hard-fails with 406 above 300 changed files, which stalls the
      # review step forever (the loop error-sleeps and retries the same doomed call). Fall
      # back to diffing locally. Rename detection is the point: the API counts a rename as
      # 2 files, so a mechanical sweep blows the limit while the reviewable delta is small.
      derr="$(mktemp)"
      if gh pr diff "$NUM" 2>"$derr"; then rm -f "$derr"
      elif grep -qiE 'HTTP 406|not acceptable|too (large|many)|diff is too big' "$derr"; then
        rm -f "$derr"
        v="$(gh pr view "$NUM" --json baseRefName,headRefName)"
        dbase="$(jq -r '.baseRefName' <<<"$v")"; dhead="$(jq -r '.headRefName' <<<"$v")"
        [[ -n "$dbase" && -n "$dhead" ]] || die "pr-diff: 406 fallback could not resolve the PR's refs"
        # Explicit refspecs: a bare `git fetch origin <branch>` writes FETCH_HEAD and only
        # updates refs/remotes/origin/<branch> opportunistically, when the clone's configured
        # refspec happens to cover it. A --single-branch clone's does not, and the three-dot
        # diff below would then die on an unknown revision. Leading '+' so a force-pushed head
        # still updates the tracking ref instead of failing the fetch.
        git fetch -q origin \
          "+refs/heads/$dbase:refs/remotes/origin/$dbase" \
          "+refs/heads/$dhead:refs/remotes/origin/$dhead" \
          || die "pr-diff: 406 fallback could not fetch origin/$dbase and origin/$dhead"
        echo "### forge: GitHub pr-diff returned 406 (>300 changed files); diffed locally with rename detection."
        echo "### Pure renames appear as rename headers without hunks — the content delta is below."
        echo
        # Three-dot: diff origin/$dhead against its merge-base with origin/$dbase.
        git --no-pager diff --find-renames --stat "origin/$dbase...origin/$dhead"
        echo
        git --no-pager diff --find-renames "origin/$dbase...origin/$dhead"
      else
        # Any other failure (auth, 404, transient 5xx) must surface unchanged so the
        # existing retry/fail-fast paths keep working.
        cat "$derr" >&2; rm -f "$derr"; exit 1
      fi
    else glab mr diff "$NUM"; fi ;;

  pr-approve)
    [[ -n "$NUM" ]] || die "pr-approve needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr review "$NUM" --approve $( [[ -n "$body" ]] && echo --body "$body" )
    else
      glab mr approve "$NUM"
      [[ -n "$body" ]] && glab mr note "$NUM" -m "$body" || true
    fi ;;

  pr-request-changes)
    [[ -n "$NUM" ]] || die "pr-request-changes needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr review "$NUM" --request-changes --body "${body:-Changes requested.}"
    else
      # GitLab has no native "request changes": mark with a label + a marked comment.
      glab label create "$CHANGES_LABEL" --color "#D93F0B" 2>/dev/null || true
      glab mr update "$NUM" --label "$CHANGES_LABEL"
      glab mr note "$NUM" -m "[forge:changes-requested] ${body:-Changes requested.}"
    fi ;;

  pr-changes-count)
    [[ -n "$NUM" ]] || die "pr-changes-count needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json reviews | jq '[.reviews[] | select(.state=="CHANGES_REQUESTED")] | length'
    else
      glab mr note list "$NUM" -F json 2>/dev/null | jq '[.[].notes[]? | select(.body | startswith("[forge:changes-requested]"))] | length' 2>/dev/null || echo 0
    fi ;;

  pr-review-gate)  # {head, blockingBody, blockingSha, rebuttal, headReviewed} — review state for the merge gate and re-review (#81)
    # blockingBody/blockingSha: the LATEST changes-requested review and the commit it was made on.
    # rebuttal: the latest `[afk:rebuttal]` comment posted after that review ("" if none).
    # headReviewed: "true" if some review was submitted on the CURRENT head after that block — i.e.
    # re-reviewing again won't change anything (another reviewer's block still stands).
    # GitLab: a changes-requested note carries no commit, so blockingSha is "" there (the
    # same-commit merge backstop is GitHub-only; GitLab keeps its label flow).
    [[ -n "$NUM" ]] || die "pr-review-gate needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json headRefOid,reviews,comments | jq '
        ([.reviews[] | select(.state == "CHANGES_REQUESTED")] | last) as $b
        | {head: .headRefOid,
           blockingBody: ($b.body // ""),
           blockingSha: ($b.commit.oid // ""),
           rebuttal: (if $b == null then "" else
             ([.comments[] | select((.body | startswith("[afk:rebuttal]")) and (.createdAt > $b.submittedAt))] | last | .body // "") end),
           headReviewed: (if $b == null then "false" else
             (.headRefOid as $h | [.reviews[] | select((.commit.oid // "") == $h and .submittedAt > $b.submittedAt)] | if length > 0 then "true" else "false" end) end)}'
    else
      mr="$(glab mr view "$NUM" -F json)"
      notes="$(glab mr note list "$NUM" -F json)"
      jq -n --argjson mr "$mr" --argjson notes "$notes" '
        [$notes[].notes[]?] | sort_by(.created_at) as $all
        | ($all | map(select(.body | startswith("[forge:changes-requested]"))) | last) as $b
        | {head: ($mr.sha // ""),
           blockingBody: (($b.body // "") | sub("^\\[forge:changes-requested\\] ?"; "")),
           blockingSha: "",
           rebuttal: (if $b == null then "" else
             ($all | map(select((.body | startswith("[afk:rebuttal]")) and (.created_at > $b.created_at))) | last | .body // "") end),
           headReviewed: "false"}'
    fi ;;

  pr-heal-count)  # heal ATTEMPTS against the budget: [forge:heal] notes after the last [forge:heal-reset] (#69)
    # The budget used to count changes-requested REVIEWS (pr-changes-count), so re-reviews of an
    # unchanged head parked PRs that were never healed, and nothing could reset it.
    [[ -n "$NUM" ]] || die "pr-heal-count needs <number>"
    since_reset='(map(startswith("[forge:heal-reset]")) | indices(true) | last) as $i
      | .[(if $i == null then 0 else $i + 1 end):] | map(select(startswith("[forge:heal]"))) | length'
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json comments | jq "[.comments[].body] | $since_reset"
    else
      glab mr note list "$NUM" -F json 2>/dev/null | jq "[.[].notes[]?.body] | $since_reset" 2>/dev/null || echo 0
    fi ;;

  pr-heal-mark)  # record one heal attempt (posted BEFORE the heal runs, so a crashed heal still counts)
    [[ -n "$NUM" ]] || die "pr-heal-mark needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh pr comment "$NUM" --body "[forge:heal]"; else glab mr note "$NUM" -m "[forge:heal]"; fi ;;

  pr-heal-reset)  # give a PR a fresh heal budget (e.g. a human un-parking it); keeps the audit trail
    [[ -n "$NUM" ]] || die "pr-heal-reset needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh pr comment "$NUM" --body "[forge:heal-reset]"; else glab mr note "$NUM" -m "[forge:heal-reset]"; fi ;;

  pr-clear-changes)  # GitLab ONLY: remove the changes-requested label so the MR reads "needs review" again
    # GitHub: a no-op — a CHANGES_REQUESTED review stands until a newer review by the same reviewer
    # supersedes it. The loop calls this only after a VERIFIED new head (or a posted rebuttal), never
    # merely because a heal ran (#81).
    [[ -n "$NUM" ]] || die "pr-clear-changes needs <number>"
    if [[ "$PLATFORM" == gitlab ]]; then glab mr update "$NUM" --unlabel "$CHANGES_LABEL" 2>/dev/null || true; fi ;;

  pr-merge)
    [[ -n "$NUM" ]] || die "pr-merge needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr merge "$NUM" $( [[ "${SQUASH}" == 1 ]] && echo --squash ) $( [[ "${DELBR}" == 1 ]] && echo --delete-branch )
    else
      glab mr merge "$NUM" $( [[ "${SQUASH}" == 1 ]] && echo --squash ) $( [[ "${DELBR}" == 1 ]] && echo --remove-source-branch ) $( [[ "${NOAUTO}" == 1 ]] && echo --auto-merge=false ) --yes
    fi ;;

  pr-label)
    [[ -n "$NUM" ]] || die "pr-label needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      args=(pr edit "$NUM")
      for l in "${add_labels[@]:-}"; do [[ -n "$l" ]] && args+=(--add-label "$l"); done
      for l in "${rm_labels[@]:-}"; do [[ -n "$l" ]] && args+=(--remove-label "$l"); done
      gh "${args[@]}"
    else
      args=(mr update "$NUM")
      [[ ${#add_labels[@]:-0} -gt 0 ]] && args+=(--label "$(csv "${add_labels[@]}")")
      [[ ${#rm_labels[@]:-0} -gt 0 ]] && args+=(--unlabel "$(csv "${rm_labels[@]}")")
      glab "${args[@]}"
    fi ;;

  pr-comment)
    [[ -n "$NUM" ]] || die "pr-comment needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh pr comment "$NUM" --body "$body"; else glab mr note "$NUM" -m "$body"; fi ;;

  pr-pipeline)  # -> {status, id}; status in success|running|pending|failed|canceled|skipped|none
    [[ -n "$NUM" ]] || die "pr-pipeline needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      # VERIFY (gh): roll up the status-check rollup
      gh pr view "$NUM" --json statusCheckRollup,headRefOid | jq '
        (.statusCheckRollup // []) as $c | { id: .headRefOid, status: (
          if ($c|length)==0 then "none"
          elif ($c|any(((.conclusion // "")) as $x | ($x=="FAILURE" or $x=="TIMED_OUT" or $x=="CANCELLED" or $x=="STARTUP_FAILURE"))) then "failed"
          elif ($c|any(((.status // "")) as $x | ($x=="IN_PROGRESS" or $x=="QUEUED" or $x=="PENDING" or $x=="WAITING"))) then "running"
          else "success" end) }'
    else
      read -r pid iid _ < <(gl_ctx "$NUM")
      glab api "projects/$pid/merge_requests/$iid" | jq '
        (.head_pipeline) as $p | { id: ($p.id // null), status: (
          if $p == null then "none"
          else ($p.status) as $s |
            if $s=="success" then "success" elif $s=="failed" then "failed"
            elif $s=="canceled" then "canceled" elif $s=="skipped" then "skipped"
            else "running" end end) }'
    fi ;;

  pr-pipeline-retry)  # retry failed/canceled jobs in the head pipeline
    [[ -n "$NUM" ]] || die "pr-pipeline-retry needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      rid="$(gh run list --branch "$(gh pr view "$NUM" --json headRefName -q .headRefName)" --json databaseId -L 1 -q '.[0].databaseId' 2>/dev/null)"
      [[ -n "$rid" ]] && gh run rerun "$rid" --failed && echo "rerun $rid" || echo "(no run to retry)"
    else
      read -r pid iid pip < <(gl_ctx "$NUM")
      [[ -n "$pip" ]] && glab api --method POST "projects/$pid/pipelines/$pip/retry" >/dev/null && echo "retried pipeline $pip" || echo "(no pipeline to retry)"
    fi ;;

  pr-pipeline-failed-jobs)  # newline-separated failed job names (for the flaky-job check)
    [[ -n "$NUM" ]] || die "pr-pipeline-failed-jobs needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      rid="$(gh run list --branch "$(gh pr view "$NUM" --json headRefName -q .headRefName)" --json databaseId -L 1 -q '.[0].databaseId' 2>/dev/null)"
      [[ -n "$rid" ]] && gh run view "$rid" --json jobs | jq -r '.jobs[] | select(.conclusion=="failure") | .name' || true
    else
      read -r pid iid pip < <(gl_ctx "$NUM")
      [[ -n "$pip" ]] && glab api "projects/$pid/pipelines/$pip/jobs?scope=failed" | jq -r '.[].name' || true
    fi ;;

  pr-pipeline-failures)  # failed job names + trace tails, for the heal prompt
    [[ -n "$NUM" ]] || die "pr-pipeline-failures needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      rid="$(gh run list --branch "$(gh pr view "$NUM" --json headRefName -q .headRefName)" --json databaseId -L 1 -q '.[0].databaseId' 2>/dev/null)"
      [[ -n "$rid" ]] && gh run view "$rid" --log-failed 2>/dev/null | tail -200 || echo "(no failed logs)"
    else
      read -r pid iid pip < <(gl_ctx "$NUM")
      if [[ -z "$pip" ]]; then echo "(no pipeline)"; else
        glab api "projects/$pid/pipelines/$pip/jobs?scope=failed" | jq -r '.[].id' | while read -r jid; do
          echo "### FAILED JOB: $(glab api "projects/$pid/jobs/$jid" | jq -r '.name')"
          glab api "projects/$pid/jobs/$jid/trace" 2>/dev/null | tail -60; echo
        done
      fi
    fi ;;

  pr-pipeline-retry-count)  # count of [forge:pipeline-retry] markers (stateless retry budget)
    [[ -n "$NUM" ]] || die "pr-pipeline-retry-count needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json comments | jq '[.comments[] | select(.body | startswith("[forge:pipeline-retry]"))] | length'
    else
      glab mr note list "$NUM" -F json 2>/dev/null | jq '[.[].notes[]? | select(.body | startswith("[forge:pipeline-retry]"))] | length' 2>/dev/null || echo 0
    fi ;;

  pr-pipeline-retry-mark)  # record one retry attempt
    [[ -n "$NUM" ]] || die "pr-pipeline-retry-mark needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh pr comment "$NUM" --body "[forge:pipeline-retry]"; else glab mr note "$NUM" -m "[forge:pipeline-retry]"; fi ;;

  pr-has-conflicts)  # "true" if the PR/MR has merge conflicts with its target branch, else "false"
    [[ -n "$NUM" ]] || die "pr-has-conflicts needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json mergeable | jq -r 'if .mergeable == "CONFLICTING" then "true" else "false" end'
    else
      read -r pid iid _ < <(gl_ctx "$NUM")
      glab api "projects/$pid/merge_requests/$iid" | jq -r '.has_conflicts // false'
    fi ;;

  pr-head-exists)  # "true"/"false": does the PR/MR's source branch exist on origin? (#61, #65)
    # An orphan (source branch missing) reads as "conflicting" on GitLab, so the loop must ask this
    # first. Absence is not proof: ANY API or git error exits non-zero — never prints "false".
    # The payload's head SHA is IGNORED on purpose (#65): forge metadata lags (a pushed GitLab MR
    # can sit at `sha: null` for minutes while "preparing"), and a false "missing" gets a healthy PR
    # closed and its branch deleted. Only origin is authoritative; the payload supplies the NAME.
    [[ -n "$NUM" ]] || die "pr-head-exists needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      head_ref="$(gh pr view "$NUM" --json headRefName | jq -r '.headRefName // ""')"
    else
      head_ref="$(glab mr view "$NUM" -F json | jq -r '.source_branch // ""')"
    fi
    [[ -n "$head_ref" ]] || die "pr-head-exists: no source branch name in the PR/MR payload"
    remote_line="$(git ls-remote --heads origin "refs/heads/$head_ref")" || die "pr-head-exists: git ls-remote failed"
    if [[ -n "$remote_line" ]]; then echo true; else echo false; fi ;;

  pr-close)  # close a PR/MR; already closed (or merged) is a no-op that exits 0 (#61)
    [[ -n "$NUM" ]] || die "pr-close needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      st="$(gh pr view "$NUM" --json state | jq -r '.state')"
      [[ "$st" == OPEN ]] || exit 0
      gh pr close "$NUM"
    else
      st="$(glab mr view "$NUM" -F json | jq -r '.state')"
      [[ "$st" == opened ]] || exit 0
      glab mr close "$NUM"
    fi ;;

  pr-recheck-mergeability)  # ask the forge to recompute a PR's mergeability; exits 0 when done (#68)
    # A stale "conflicting" flag (the branch already contains base) doesn't clear on its own on a
    # degraded GitLab; a rebase request — a no-op when already up to date — forces a recompute.
    # GitHub recomputes lazily on read: nothing to do.
    [[ -n "$NUM" ]] || die "pr-recheck-mergeability needs <number>"
    if [[ "$PLATFORM" == gitlab ]]; then
      mr="$(glab mr view "$NUM" -F json)"
      glab api -X PUT "projects/$(jq -r '.project_id' <<<"$mr")/merge_requests/$(jq -r '.iid' <<<"$mr")/rebase" >/dev/null
    fi ;;

  pr-conflict-retry-count)  # CONSECUTIVE failed conflict resolutions: [forge:conflict-retry] markers after the last [forge:conflict-resolved] (#54)
    [[ -n "$NUM" ]] || die "pr-conflict-retry-count needs <number>"
    # A lifetime total parks a healthy PR the Nth time main moves under it, even when every
    # earlier resolution succeeded. Count only the attempts since the last success.
    since_reset='(map(startswith("[forge:conflict-resolved]")) | indices(true) | last) as $i
      | .[(if $i == null then 0 else $i + 1 end):] | map(select(startswith("[forge:conflict-retry]"))) | length'
    if [[ "$PLATFORM" == github ]]; then
      gh pr view "$NUM" --json comments | jq "[.comments[].body] | $since_reset"
    else
      glab mr note list "$NUM" -F json 2>/dev/null | jq "[.[].notes[]?.body] | $since_reset" 2>/dev/null || echo 0
    fi ;;

  pr-conflict-retry-mark)  # record one conflict-resolve attempt
    [[ -n "$NUM" ]] || die "pr-conflict-retry-mark needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh pr comment "$NUM" --body "[forge:conflict-retry]"; else glab mr note "$NUM" -m "[forge:conflict-retry]"; fi ;;

  pr-conflict-retry-clear)  # record a SUCCESSFUL conflict resolution: resets the consecutive-failure count to 0 (#54)
    [[ -n "$NUM" ]] || die "pr-conflict-retry-clear needs <number>"
    if [[ "$PLATFORM" == github ]]; then gh pr comment "$NUM" --body "[forge:conflict-resolved]"; else glab mr note "$NUM" -m "[forge:conflict-resolved]"; fi ;;

  git-setup)  # configure git push credentials (+ commit identity, when given) for the current platform
    # [--git-name N --git-email E]: pin the commit identity (#52). Upstream copies the HOST
    # clone's user.name/email into each sandbox, so without this every phase commits as
    # whichever clone/config ran it. Both or neither — a half-set identity is a config bug.
    if [[ -n "$git_name" || -n "$git_email" ]]; then
      [[ -n "$git_name" && -n "$git_email" ]] || die "git-setup needs both --git-name and --git-email"
      git config --global user.name "$git_name"
      git config --global user.email "$git_email"
    fi
    if [[ "$PLATFORM" == github ]]; then
      git config --global credential.helper '!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
    else
      git config --global credential.helper '!f() { echo username=oauth2; echo "password=${GITLAB_TOKEN:-$GLAB_TOKEN}"; }; f'
    fi ;;

  pr-feedback)  # ALL reviewer feedback (review summaries + inline threads + comments), for heal
    [[ -n "$NUM" ]] || die "pr-feedback needs <number>"
    if [[ "$PLATFORM" == github ]]; then
      {
        gh pr view "$NUM" --json reviews \
          | jq -r '.reviews[] | select((.body // "") != "") | "### review by \(.author.login) [\(.state)]\n\(.body)\n"'
        gh api "repos/{owner}/{repo}/pulls/${NUM}/comments" 2>/dev/null \
          | jq -r '.[] | "### inline @ \(.path):\(.line // .original_line) (\(.user.login))\n\(.body)\n"' 2>/dev/null || true
        gh pr view "$NUM" --json comments \
          | jq -r '.comments[] | "### comment by \(.author.login)\n\(.body)\n"'
      }
    else
      glab mr note list "$NUM" -F json 2>/dev/null \
        | jq -r '.[].notes[]? | select((.system // false) | not) | "### note by \(.author.username // "?")\n\(.body)\n"'
    fi ;;

  *) die "unknown verb '$verb'. See bin/forge for the verb list." ;;
esac
}

# Run the verb; on a transient error from a READ verb, retry with exponential
# backoff. stdout is buffered so a failed attempt never emits partial output.
run_with_retry() {
  local out err rc attempt=0 delay
  out="$(mktemp)"; err="$(mktemp)"
  while :; do
    set +e; ( set -e; dispatch ) >"$out" 2>"$err"; rc=$?; set -e
    if [[ "$rc" -eq 0 ]]; then cat "$out"; rm -f "$out" "$err"; return 0; fi
    if is_retryable_verb "$verb" && [[ "$attempt" -lt "$FORGE_MAX_RETRIES" ]] && grep -qiE "$TRANSIENT_RE" "$err"; then
      attempt=$((attempt + 1))
      delay=$(( FORGE_RETRY_BASE_SECONDS * (2 ** (attempt - 1)) ))
      { echo "forge: transient error on '$verb' (attempt ${attempt}/${FORGE_MAX_RETRIES}); retrying in ${delay}s"; cat "$err"; } >&2
      sleep "$delay"
      continue
    fi
    cat "$err" >&2; rm -f "$out" "$err"; return "$rc"
  done
}

run_with_retry
